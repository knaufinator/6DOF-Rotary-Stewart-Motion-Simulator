sdkconfig
sdkconfig.old
/include/version_auto.h

# Locally generated C++/debug configuration, not shared IDE settings.
/.vscode/.browse.c_cpp.db*
/.vscode/c_cpp_properties.json
/.vscode/launch.json
/.vscode/ipch/

# Existing tracked managed components and diagnostic files are retained.
