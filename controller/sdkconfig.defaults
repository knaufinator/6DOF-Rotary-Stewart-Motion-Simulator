# Stewart Platform Motion Controller — Common Configuration
# Shared by both PCBv1 (ESP32) and PCBv2 (ESP32-S3).
# Target-specific overrides are in:
#   sdkconfig.defaults.esp32   — PCBv1 (original DevKit + MCP23S17)
#   sdkconfig.defaults.esp32s3 — PCBv2 (new board, MCPWM + W5500)
#
# Build:
#   idf.py set-target esp32    # PCBv1
#   idf.py set-target esp32s3  # PCBv2
#   idf.py build

# FreeRTOS Configuration for real-time performance
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=1

# Task watchdog
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Interrupt watchdog
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300

# GPTimer Configuration
CONFIG_GPTIMER_ENABLE_DEBUG_LOG=n
CONFIG_GPTIMER_ISR_IRAM_SAFE=n
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=n

# Compiler optimization for performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Memory configuration
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MAIN_TASK_STACK_SIZE=8192

# ESP Timer configuration
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_INTERRUPT_LEVEL=1
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# NVS (Non-Volatile Storage)
CONFIG_NVS_ENCRYPTION=n

# Partition table
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Bootloader
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# Component config
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

