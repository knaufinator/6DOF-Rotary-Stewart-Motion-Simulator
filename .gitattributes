# Keep source diffs portable and readable.
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
CMakeLists.txt text eol=lf
*.pdf binary
*.png binary
*.zip binary
*.epro2 binary
controller/profiles/mini/partitions.csv text eol=lf
controller/profiles/*.lock text eol=lf

# Preserve native engineering files and recovered-source evidence exactly.
hardware/pcb/6dof2_r14/** -text
hardware/pcb/6dof2_r14/** whitespace=trailing-space,space-before-tab,cr-at-eol
hardware/pcb/6dof2_r14/exports/** -whitespace
hardware/pcb/6dof2_r14/review/r13-recovered-source/** -whitespace

# Preserve raw emulator evidence against its recorded SHA-256 digests.
docs/testing/r14-runtime/2026-10-28/** -text

