# Select the hardware contract before ESP-IDF reads sdkconfig or components.
set(FIRMWARE_PROFILE "r14" CACHE STRING "mini, r14, r13-bench or legacy")
set_property(CACHE FIRMWARE_PROFILE PROPERTY STRINGS mini r14 r13-bench legacy)
if(FIRMWARE_PROFILE STREQUAL "mini")
    set(PROFILE_TARGET esp32)
    set(PROFILE_MINI 1)
    set(PROFILE_BOARD_IO OFF)
    set(PROFILE_BENCH OFF)
    set(PROFILE_LOCK OFF)
elseif(FIRMWARE_PROFILE STREQUAL "r14")
    set(PROFILE_TARGET esp32s3)
    set(PROFILE_MINI 0)
    set(PROFILE_BOARD_IO ON)
    set(PROFILE_BENCH OFF)
    set(PROFILE_LOCK ON)
elseif(FIRMWARE_PROFILE STREQUAL "r13-bench")
    set(PROFILE_TARGET esp32s3)
    set(PROFILE_MINI 0)
    set(PROFILE_BOARD_IO OFF)
    set(PROFILE_BENCH ON)
    set(PROFILE_LOCK ON)
elseif(FIRMWARE_PROFILE STREQUAL "legacy")
    set(PROFILE_TARGET esp32)
    set(PROFILE_MINI 0)
    set(PROFILE_BOARD_IO OFF)
    set(PROFILE_BENCH OFF)
    set(PROFILE_LOCK OFF)
else()
    message(FATAL_ERROR "Unknown FIRMWARE_PROFILE '${FIRMWARE_PROFILE}'")
endif()
if(NOT DEFINED IDF_TARGET AND DEFINED ENV{IDF_TARGET})
    set(IDF_TARGET "$ENV{IDF_TARGET}")
endif()
if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL PROFILE_TARGET)
    message(FATAL_ERROR "Profile ${FIRMWARE_PROFILE} requires ${PROFILE_TARGET}, not ${IDF_TARGET}")
endif()
set(IDF_TARGET "${PROFILE_TARGET}" CACHE STRING "Profile chip target")

function(profile_option name expected)
    if(DEFINED ${name})
        if((${name} AND NOT expected) OR (NOT ${name} AND expected))
            message(FATAL_ERROR "Profile ${FIRMWARE_PROFILE} requires ${name}=${expected}")
        endif()
    endif()
    set(${name} ${expected} CACHE BOOL "Selected by FIRMWARE_PROFILE")
endfunction()
profile_option(R14_BOARD_IO ${PROFILE_BOARD_IO})
profile_option(R13_BENCH_ONE_AXIS ${PROFILE_BENCH})
profile_option(R14_FAIL_CLOSED ${PROFILE_LOCK})

# A fresh SDK config and build directory are required when changing hardware.
set(profile_stamp "${CMAKE_BINARY_DIR}/controller-profile.txt")
if(EXISTS "${profile_stamp}")
    file(READ "${profile_stamp}" previous_profile)
    if(NOT previous_profile STREQUAL FIRMWARE_PROFILE)
        message(FATAL_ERROR "Build directory belongs to ${previous_profile}; use a separate build directory for ${FIRMWARE_PROFILE}")
    endif()
endif()
file(WRITE "${profile_stamp}" "${FIRMWARE_PROFILE}")
