# Repository-wide transient files only.
# Project build/runtime rules live in controller/.gitignore and app/.gitignore.
# Never blanket-ignore CAD/EDA extensions such as .obj, .lib, .zip or .step.

# Python environments and caches (source, requirements and lockfiles stay visible).
__pycache__/
*.pyc
*.pyo
.venv/
.coverage
.coverage.*
.pytest_cache/

# Installed JavaScript dependencies, not authored build/ packaging scripts.
node_modules/

# Editor and operating-system caches; shared IDE settings remain visible.
.vscode/.browse.c_cpp.db*
.vscode/ipch/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Separate embedded Git checkouts with their own local modifications.
# Preserve them locally; do not accidentally add unconfigured gitlinks.
# Other legacy PCB designs, libraries, scripts and evidence stay visible.
/hardware/pcb/legacy/easyeda-mcp/
/hardware/pcb/legacy/pro-api-sdk/
